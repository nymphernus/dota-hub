APP_NAME="Stats Radar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=stats_radar
DB_USERNAME=stats_radar
DB_PASSWORD=change-me-in-production

# ---------------------------------------------------------------------------
# Cache, sessions and queues (Redis)
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=stats-radar

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------------------
# External APIs
# ---------------------------------------------------------------------------
# Optional: raises the OpenDota rate limit and is appended to API requests.
OPENDOTA_API_KEY=
# Player profiles are persisted in PostgreSQL and refreshed after this many seconds (default: 1 hour).
OPENDOTA_CACHE_TTL=3600
# Per-hero player aggregates (last 100 games) are cached for 30 minutes.
OPENDOTA_PLAYER_HERO_CACHE_TTL=1800
# Hero benchmark percentiles change slowly and are cached for a day.
OPENDOTA_BENCHMARKS_CACHE_TTL=86400
# Finished matches never change; their details are cached for an hour.
OPENDOTA_MATCH_CACHE_TTL=3600
# OpenDota allows 2000 requests per day per IP/key. The client stops at this limit.
OPENDOTA_DAILY_LIMIT=2000
# Global hero metadata (names, images) is cached for a day.
OPENDOTA_HEROES_CACHE_TTL=86400
# Global item metadata (names, images, costs for match purchases) is cached for a day.
OPENDOTA_ITEMS_CACHE_TTL=86400
# Docker only: pin api.opendota.com to a reachable Cloudflare edge if local DNS
# returns edge IPs that the container cannot connect to.
OPENDOTA_API_IP=104.16.0.1

# How many recent searches to show on the home page.
RECENT_SEARCHES_COUNT=5

# Optional: enables Steam /id/ vanity URLs and Steam account privacy details
# on the profile page (https://steamcommunity.com/dev/apikey).
STEAM_API_KEY=
# Must exactly match the URL Steam returns to. Keep it relative or use the
# full public URL (for example http://localhost/auth/steam/callback).
STEAM_REDIRECT_URI=/auth/steam/callback
# Optional override for openid.realm (host plus path, without scheme).
# By default it follows the redirect URL, e.g. localhost/auth/steam/callback.
STEAM_REALM=
# Set to true when the public callback URL uses HTTPS.
STEAM_FORCE_HTTPS=false
STEAM_CACHE_TTL=1800
STEAM_VANITY_CACHE_TTL=604800

# Optional: STRATZ GraphQL API token (https://stratz.com/api).
# STRATZ_API_KEY takes precedence; STRATZ_TOKEN is kept for compatibility.
STRATZ_API_KEY=
STRATZ_TOKEN=
STRATZ_ENDPOINT=https://api.stratz.com/graphql

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@stats-radar.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
