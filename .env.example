APP_NAME="Stats Radar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=stats_radar
DB_USERNAME=stats_radar
DB_PASSWORD=change-me-in-production

# ---------------------------------------------------------------------------
# Cache, sessions and queues (Redis)
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=stats-radar

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------------------
# External APIs
# ---------------------------------------------------------------------------
# Optional: raises the OpenDota rate limit and is appended to API requests.
OPENDOTA_API_KEY=
# Profile/hero/match data is cached for this many seconds (default: 30 min).
OPENDOTA_CACHE_TTL=1800
# OpenDota allows 2000 requests per day per IP/key. The client stops at this limit.
OPENDOTA_DAILY_LIMIT=2000
# Global hero metadata (names, images) is cached for a day.
OPENDOTA_HEROES_CACHE_TTL=86400

# How many recent searches to show on the home page.
RECENT_SEARCHES_COUNT=8

# Required for CS2 profiles and Steam /id/ vanity URLs (https://steamcommunity.com/dev/apikey).
STEAM_API_KEY=
STEAM_CACHE_TTL=1800
STEAM_VANITY_CACHE_TTL=604800
STEAM_CS2_APP_ID=730

# Optional: STRATZ GraphQL API token (https://stratz.com/api).
STRATZ_TOKEN=
STRATZ_ENDPOINT=https://api.stratz.com/graphql

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@stats-radar.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
